{
  "name": "savannah-property-guardians",
  "version": "1.0.0",
  "description": "Savannah Property Guardians website - Built with Eleventy + Tailwind CSS",
  "main": "index.js",
  "scripts": {
    "start": "cross-env ELEVENTY_ENV=local npm run dev",
    "dev": "cross-env ELEVENTY_ENV=local concurrently -n \"CSS,ELEVENTY\" -c \"magenta,blue\" \"npm:watch:css\" \"npx @11ty/eleventy --serve\"",
    "build:css": "cross-env ELEVENTY_ENV=production npx @tailwindcss/cli -i ./src/assets/css/input.css -o ./src/assets/css/style.css -c tailwind.config.js --minify",
    "watch:css": "cross-env ELEVENTY_ENV=local npx @tailwindcss/cli -i ./src/assets/css/input.css -o ./src/assets/css/style.css --watch",
    "build": "cross-env ELEVENTY_ENV=production npm run build:css && npx @11ty/eleventy",
    "build:gh-pages": "cross-env ELEVENTY_ENV=production npm run build:css && npx @11ty/eleventy --output=docs",
    "lint": "npm run lint:js && npm run lint:css && npm run format:check",
    "lint:js": "eslint src/**/*.js",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix && npm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:build": "npm run build:gh-pages",
    "test:html-urls": "node tests/test-html-urls.js",
    "test:ldjson-urls": "node tests/test-ldjson-urls.js",
    "test:sitemap-urls": "node tests/test-sitemap-urls.js",
    "test:sitemap-resolves": "node tests/test-sitemap-resolves.js",
    "test:seo-frontmatter": "node tests/test-seo-frontmatter.js",
    "test:seo-images": "node tests/test-seo-images.js",
    "test": "npm run verify:build && npm run test:html-urls && npm run test:ldjson-urls && npm run test:sitemap-urls && npm run test:sitemap-resolves && npm run test:seo-frontmatter && npm run test:seo-images"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@tailwindcss/cli": "4.0.12",
    "@tailwindcss/postcss": "4.0.12",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "html-minifier-terser": "^7.2.0",
    "postcss": "^8.5.15",
    "prettier": "^3.3.3",
    "stylelint": "^16.17.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-prettier": "^5.0.0",
    "tailwindcss": "4.0.12"
  },
  "optionalDependencies": {
    "@parcel/watcher-linux-x64-glibc": "^2.5.6",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.0.12",
    "lightningcss-linux-x64-gnu": "^1.32.0"
  }
}
