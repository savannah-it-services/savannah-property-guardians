---
layout: base.njk
title: Savannah Property Guardians | Property Care & Maintenance Experts
description: Professional handyman, commercial property maintenance, warehouse management, and plumbing services across the Southeast. Trusted since 2014.
---

{% block additional_schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "name": "{{ site.name }}",
      "url": "{{ site.url }}",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.97",
        "reviewCount": "{{ reviews | length }}"
      }
    }
    {% for review in reviews %},
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": "{{ review.name }}"
      },
      "reviewBody": "{{ review.quote | replace('"', '\\"') }}",
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "5"
      },
      "itemReviewed": {
        "@type": "LocalBusiness",
        "name": "{{ site.name }}"
      }
    }
    {% endfor %}
  ]
}
</script>
{% endblock %}

<!-- HERO -->
<header class="hero-bg pt-20 min-h-[100dvh] flex items-center relative">
  <div class="hero-pattern absolute inset-0"></div>

  <div class="max-w-5xl mx-auto px-6 pt-12 pb-16 relative z-10">
    <div class="max-w-4xl">
      <h1 class="text-white text-[52px] sm:text-[64px] leading-[1.05] font-semibold tracking-[-2.4px] mb-6">
        Guardians of your<br>property. <span class="text-spg-gold">Always.</span>
      </h1>

      <p class="max-w-[560px] text-xl text-white/80 mb-10">
        Professional handyman, commercial maintenance, warehouse management,
        and plumbing services delivered with integrity and craftsmanship.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <button data-open-quote
                class="btn-gold inline-flex justify-center items-center px-9 py-4 rounded-2xl text-lg font-semibold tracking-wide">
          Get a Free Quote
        </button>
        <a href="#services"
           class="inline-flex justify-center items-center px-9 py-4 rounded-2xl text-lg font-semibold text-white border-2 border-white/70 hover:bg-white/10 transition-all">
          Explore Our Services
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-9 left-1/2 -translate-x-1/2 hidden md:flex flex-col items-center text-white/50 text-xs tracking-widest">
    <span>SCROLL TO EXPLORE</span>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-1 animate-bounce" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3"/>
    </svg>
  </div>
</header>

<!-- TRUST BAR -->
<div class="border-b border-[#EDE4D4] bg-white py-5">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4 text-sm text-spg-text-light font-medium tracking-wide">
      <div class="flex items-center gap-x-2">
        <span class="text-spg-gold">●</span> Licensed &amp; Insured
      </div>

      <div class="flex items-center gap-x-2">
        <span class="text-spg-gold">●</span> 100% Satisfaction Guarantee
      </div>
      <div class="flex items-center gap-x-2">
        <span class="text-spg-gold">●</span> Same-Day Emergency Response
      </div>
    </div>
  </div>
</div>

<!-- SERVICES OVERVIEW -->
<section id="services" class="max-w-7xl mx-auto px-6 pt-20 pb-16">
  <div class="text-center mb-14">
    <div class="uppercase tracking-[3px] text-xs font-semibold text-spg-gold mb-3">WHAT WE OFFER</div>
    <h2 class="text-5xl tracking-tight font-semibold text-spg-green">Complete Property Solutions</h2>
    <p class="mt-4 max-w-md mx-auto text-spg-text-light text-lg">Four specialized service lines. One trusted partner.</p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Handyman -->
    <a href="{{ '/handyman' | url }}" class="service-card group bg-white rounded-3xl p-8 flex flex-col">
      <div class="service-icon w-14 h-14 rounded-2xl bg-[#F1EDE3] flex items-center justify-center text-spg-green mb-7">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z"/>
        </svg>
      </div>
      <h3 class="text-2xl font-semibold tracking-tight mb-3 text-spg-green group-hover:text-spg-gold transition-colors">Handyman Services</h3>
      <p class="text-spg-text-light flex-1">Reliable repairs, installations, and maintenance for homes and light commercial spaces. Quality craftsmanship on every job.</p>
      <div class="mt-8 text-spg-gold flex items-center text-sm font-semibold tracking-wider group-hover:gap-x-1.5 transition-all">
        LEARN MORE <span class="ml-1.5">→</span>
      </div>
    </a>

    <!-- Warehouse -->
    <a href="{{ '/warehouse' | url }}" class="service-card group bg-white rounded-3xl p-8 flex flex-col">
      <div class="service-icon w-14 h-14 rounded-2xl bg-[#F1EDE3] flex items-center justify-center text-spg-green mb-7">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z"/>
        </svg>
      </div>
      <h3 class="text-2xl font-semibold tracking-tight mb-3 text-spg-green group-hover:text-spg-gold transition-colors">Warehouse Management</h3>
      <p class="text-spg-text-light flex-1">End-to-end commercial warehouse operations, inventory control, loading dock maintenance, and facility optimization.</p>
      <div class="mt-8 text-spg-gold flex items-center text-sm font-semibold tracking-wider group-hover:gap-x-1.5 transition-all">
        LEARN MORE <span class="ml-1.5">→</span>
      </div>
    </a>

    <!-- Property Maintenance -->
    <a href="{{ '/property-maintenance' | url }}" class="service-card group bg-white rounded-3xl p-8 flex flex-col">
      <div class="service-icon w-14 h-14 rounded-2xl bg-[#F1EDE3] flex items-center justify-center text-spg-green mb-7">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 21v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21m0 0h4.5V3.545M12.75 21h7.5V10.75M2.25 21h1.5m18 0h-18M2.25 9l4.5-1.636M18.75 3l-1.5.545m0 6.205 3 1m1.5.5-1.5-.5M6.75 7.364V3h-3v18m3-13.636 10.5-3.819"/>
        </svg>
      </div>
      <h3 class="text-2xl font-semibold tracking-tight mb-3 text-spg-green group-hover:text-spg-gold transition-colors">Property Maintenance</h3>
      <p class="text-spg-text-light flex-1">Comprehensive commercial building care including grounds, HVAC, lighting, preventive maintenance programs and 24/7 response.</p>
      <div class="mt-8 text-spg-gold flex items-center text-sm font-semibold tracking-wider group-hover:gap-x-1.5 transition-all">
        LEARN MORE <span class="ml-1.5">→</span>
      </div>
    </a>

    <!-- Plumbing -->
    <a href="{{ '/plumbing' | url }}" class="service-card group bg-white rounded-3xl p-8 flex flex-col">
      <div class="service-icon w-14 h-14 rounded-2xl bg-[#F1EDE3] flex items-center justify-center text-spg-green mb-7">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75a4.5 4.5 0 0 1-4.884 4.484c-1.076-.091-2.264.071-2.95.904l-7.152 8.684a2.548 2.548 0 1 1-3.586-3.586l8.684-7.152c.833-.686.995-1.874.904-2.95a4.5 4.5 0 0 1 6.336-4.486l-3.276 3.276a3.004 3.004 0 0 0 2.25 2.25l3.276-3.276c.256.565.398 1.192.398 1.852Z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.867 19.125h.008v.008h-.008v-.008Z"/>
        </svg>
      </div>
      <h3 class="text-2xl font-semibold tracking-tight mb-3 text-spg-green group-hover:text-spg-gold transition-colors">Commercial Plumbing</h3>
      <p class="text-spg-text-light flex-1">Expert commercial plumbing solutions — drain cleaning, water heaters, backflow prevention, pipe repair and new construction.</p>
      <div class="mt-8 text-spg-gold flex items-center text-sm font-semibold tracking-wider group-hover:gap-x-1.5 transition-all">
        LEARN MORE <span class="ml-1.5">→</span>
      </div>
    </a>
  </div>
</section>

<!-- ABOUT TEASER -->
<section class="bg-spg-sand py-16">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid lg:grid-cols-12 gap-x-12 items-center">
      <div class="lg:col-span-7">
        <div class="uppercase text-xs tracking-[3px] font-semibold text-spg-gold mb-3">ABOUT US</div>
        <h2 class="text-spg-green text-4xl tracking-[-1.2px] font-semibold mb-4">100% Veteran Owned.<br>Built on integrity.</h2>
        <p class="text-spg-text-light max-w-xl">Savannah Property Guardians was founded on the belief that every property deserves a dedicated protector. Our veteran-led team delivers reliable, transparent service across the Southeast.</p>

        <a href="{{ '/about' | url }}" class="inline-flex items-center mt-6 text-sm font-medium text-spg-green hover:underline">
          Learn more about our story →
        </a>
      </div>

      <div class="lg:col-span-5 mt-8 lg:mt-0">
        <div class="inline-flex items-center gap-x-2.5 px-5 py-2 rounded-full bg-spg-green text-white text-sm font-semibold">
          <span class="text-lg">🇺🇸</span>
          <span>100% VETERAN OWNED</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- TESTIMONIALS -->
<section class="max-w-6xl mx-auto px-6 py-20">
  <div class="text-center mb-12">
    <div class="text-spg-gold tracking-[3px] text-xs font-semibold">REAL RESULTS. REAL PEOPLE.</div>
    <h2 class="mt-3 text-4xl font-semibold tracking-tight text-spg-green">What our clients say</h2>
  </div>

  <div id="testimonial-slider" class="max-w-4xl mx-auto">
    {% for review in reviews %}
    <div class="testimonial-slide testimonial-card bg-white border border-[#EDE4D4] rounded-3xl px-9 py-8{% if not loop.first %} hidden{% endif %}">
      <div class="flex gap-1 text-spg-gold mb-5">
        {% for i in [0,1,2,3,4] %}{% if i < review.stars %}★{% endif %}{% endfor %}
      </div>
      <blockquote class="text-[21px] leading-tight tracking-[-0.3px] text-spg-text">
        {{ review.quote }}
      </blockquote>
      <div class="mt-8 flex items-center gap-x-4">
        <div class="w-12 h-12 bg-spg-sand rounded-2xl flex-shrink-0"></div>
        <div>
          <div class="font-semibold">{{ review.name }}</div>
          <div class="text-sm text-spg-text-light">{{ review.title }}</div>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</section>
