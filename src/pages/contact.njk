---
layout: base.njk
title: Contact Us | Savannah Property Guardians
description: Get in touch with Savannah Property Guardians for professional handyman, warehouse, maintenance, plumbing, and security services across the Southeast. Free quotes and 24/7 emergency response.
---

{% set addr = site.business_address %}
{% set addrLine1 = addr.street1 %}
{% set addrLine2 = addr.street2 %}
{% set addrCityStateZip = addr.city + ', ' + addr.state + ' ' + addr.zip %}
{% set addrFullInline = addrLine1 %}
{% if addrLine2 %}
{% set addrFullInline = addrFullInline + ', ' + addrLine2 %}
{% endif %}
{% set addrFullInline = addrFullInline + ', ' + addrCityStateZip %}
{% set addrQueryBase = addrLine1 | replace(' ', '+') %}
{% if addrLine2 %}
{% set addrQueryBase = addrQueryBase + '+' + (addrLine2 | replace(' ', '+')) %}
{% endif %}
{% set addrQuery = addrQueryBase + ',+' + (addr.city | replace(' ', '+')) + ',+' + addr.state + '+' + addr.zip %}

<header class="service-hero pt-20">
  <div class="max-w-5xl mx-auto px-6 py-16 md:py-20 text-center">
    <div class="inline-block px-4 py-1 rounded-full bg-white/10 text-spg-gold text-xs tracking-[2px] font-semibold mb-4">WE'RE HERE TO HELP</div>
    <h1 class="text-white text-6xl md:text-7xl tracking-[-2.6px] font-semibold">Contact Us</h1>
    <p class="max-w-lg mx-auto mt-5 text-xl text-white/75">Reach out for a free quote, emergency service, or to learn more about how we can protect your property.</p>

    <div class="flex justify-center gap-3 mt-8">
      <button data-open-quote class="btn-gold px-8 py-3.5 rounded-2xl font-semibold">Request a Free Quote</button>
      <a href="#contact-form" class="inline-flex items-center px-8 py-3.5 rounded-2xl text-white border-2 border-white/40 hover:bg-white/10 transition">Send a Message</a>
    </div>
  </div>
</header>

<main>
  <!-- Quick Contact Info -->
  <section class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid md:grid-cols-3 gap-6">
      <!-- Phone -->
      <div class="bg-white border border-[#EDE4D4] rounded-3xl p-8 flex flex-col">
        <div class="text-spg-gold mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" />
          </svg>
        </div>
        <h3 class="font-semibold text-xl text-spg-green mb-2">Call Us</h3>
        <a href="tel:{{ site.phoneHref }}" class="text-2xl font-semibold text-spg-green hover:underline">{{ site.phone }}</a>
        <div class="mt-1 text-sm text-spg-text-light">24/7 Emergency Dispatch</div>
        <p class="mt-auto pt-6 text-sm text-spg-text-light">Our team is standing by for urgent needs.</p>
      </div>

      <!-- Email -->
      <div class="bg-white border border-[#EDE4D4] rounded-3xl p-8 flex flex-col">
        <div class="text-spg-gold mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
        </div>
        <h3 class="font-semibold text-xl text-spg-green mb-2">Email Us</h3>
        <a href="mailto:{{ site.email }}" class="text-lg font-semibold text-spg-green hover:underline break-all">{{ site.email }}</a>
        <p class="mt-auto pt-6 text-sm text-spg-text-light">We typically respond within 1 business hour during regular business hours.</p>
      </div>

      <!-- Visit -->
      <div class="bg-white border border-[#EDE4D4] rounded-3xl p-8 flex flex-col">
        <div class="text-spg-gold mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
          </svg>
        </div>
        <h3 class="font-semibold text-xl text-spg-green mb-2">Visit Us</h3>
        <div class="text-spg-text-light leading-snug">
          {{ addrLine1 }}<br>
          {% if addrLine2 %}{{ addrLine2 }}<br>{% endif %}
          {{ addrCityStateZip }}
        </div>
        <a href="https://maps.google.com/?q={{ addrQuery }}" target="_blank" class="mt-auto pt-6 inline-flex items-center text-sm font-medium text-spg-green hover:underline">
          Get Directions →
        </a>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="max-w-6xl mx-auto px-6 pb-16">
    <div class="rounded-3xl overflow-hidden border border-[#EDE4D4] shadow-sm">
      <iframe
        src="https://www.google.com/maps?q={{ addrQuery }}&z=17&output=embed"
        width="100%"
        height="420"
        style="border:0; border-radius: 1.5rem;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Savannah Property Guardians - {{ addrFullInline }}">
      </iframe>
    </div>
    <p class="text-center text-xs text-spg-text-light mt-3">{{ addrFullInline }}</p>
  </section>

  <!-- Contact Form -->
  <section id="contact-form" class="bg-white py-16 border-y border-[#EDE4D4]">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-10">
        <div class="uppercase tracking-[3px] text-xs font-semibold text-spg-gold mb-3">SEND US A MESSAGE</div>
        <h2 class="text-4xl font-semibold tracking-tight text-spg-green">Let's talk about your property.</h2>
        <p class="mt-3 text-spg-text-light max-w-md mx-auto">Whether you have a quick question or a complex project, we're here to help. Fill out the form and we'll get back to you promptly.</p>
      </div>

      <form id="contact-page-form" class="bg-spg-sand border border-[#EDE4D4] rounded-3xl p-8 md:p-10 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="contact-firstname" class="text-sm font-medium block mb-1.5">First Name *</label>
            <input id="contact-firstname" required type="text" name="firstname" class="form-input w-full rounded-2xl px-4 py-3 text-sm" placeholder="Jane">
          </div>
          <div>
            <label for="contact-lastname" class="text-sm font-medium block mb-1.5">Last Name *</label>
            <input id="contact-lastname" required type="text" name="lastname" class="form-input w-full rounded-2xl px-4 py-3 text-sm" placeholder="Cooper">
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="contact-email" class="text-sm font-medium block mb-1.5">Email Address *</label>
            <input id="contact-email" required type="email" name="email" class="form-input w-full rounded-2xl px-4 py-3 text-sm" placeholder="you@company.com">
          </div>
          <div>
            <label for="contact-phone" class="text-sm font-medium block mb-1.5">Phone Number</label>
            <input id="contact-phone" type="tel" name="phone" class="form-input w-full rounded-2xl px-4 py-3 text-sm" placeholder="(912) 555-1234">
          </div>
        </div>

        <div>
          <label for="contact-company" class="text-sm font-medium block mb-1.5">Company / Property Name</label>
          <input id="contact-company" type="text" name="company" class="form-input w-full rounded-2xl px-4 py-3 text-sm" placeholder="Acme Warehouse LLC">
        </div>

        <div>
          <label for="contact-message" class="text-sm font-medium block mb-1.5">How can we help? *</label>
          <textarea id="contact-message" required name="message" rows="5" class="form-input w-full rounded-3xl px-4 py-3 text-sm resize-y" placeholder="Tell us about your property needs, timeline, or any questions you have..."></textarea>
        </div>

        <div class="pt-2">
          <button type="submit" class="btn-primary w-full text-white py-4 font-semibold rounded-2xl text-base tracking-wider">
            SEND MESSAGE
          </button>
          <p class="text-center text-xs text-spg-text-light mt-3">We typically respond within 1 business hour during regular hours.</p>
        </div>
      </form>

      <div id="contact-success" class="hidden mt-8 text-center bg-green-50 border border-green-200 rounded-3xl p-10">
        <div class="mx-auto w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
          </svg>
        </div>
        <h3 class="text-2xl font-semibold text-spg-green">Message Received!</h3>
        <p class="mt-3 text-spg-text-light max-w-sm mx-auto">Thank you for reaching out. One of our team members will contact you shortly.</p>
      </div>
    </div>
  </section>

  <!-- Business Hours & Service Area -->
  <section class="max-w-5xl mx-auto px-6 py-16">
    <div class="grid md:grid-cols-2 gap-x-16 gap-y-10">
      <div>
        <div class="uppercase tracking-[3px] text-xs font-semibold text-spg-gold mb-3">BUSINESS HOURS</div>
        <h3 class="text-3xl font-semibold tracking-tight text-spg-green mb-4">When to reach us</h3>
        <div class="space-y-2 text-spg-text-light">
          <div class="flex justify-between border-b border-[#EDE4D4] pb-2">
            <span>Regular Hours</span>
            <span class="font-medium text-spg-text">{{ site.business_hours }}</span>
          </div>
          <div class="flex justify-between pt-1">
            <span>Emergency Service</span>
            <span class="font-medium text-spg-green">24/7 — Call {{ site.phone }}</span>
          </div>
        </div>
      </div>

      <div>
        <div class="uppercase tracking-[3px] text-xs font-semibold text-spg-gold mb-3">SERVICE AREA</div>
        <h3 class="text-3xl font-semibold tracking-tight text-spg-green mb-4">Where we work</h3>
        <p class="text-spg-text-light">We proudly serve commercial and residential properties throughout the Southeast, with a strong focus on the greater Savannah area and coastal Georgia.</p>
        <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-1 text-sm text-spg-text-light">
          <li>• Savannah & Tybee Island, GA</li>
          <li>• Chatham, Bryan & Effingham Counties</li>
          <li>• Coastal Georgia</li>
          <li>• South Carolina Lowcountry</li>
          <li>• North Georgia</li>
          <li>• And surrounding areas</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-spg-green-dark text-white">
    <div class="max-w-4xl mx-auto px-6 py-16 text-center">
      <h2 class="text-4xl tracking-[-1px] font-semibold mb-3">Ready to get started?</h2>
      <p class="text-white/70 max-w-md mx-auto mb-8">The fastest way to get a quote is to use our request form. For general questions, use the form above or call us directly.</p>
      <button data-open-quote class="btn-gold px-9 py-3.5 rounded-2xl text-lg font-semibold">Request a Free Quote Now</button>
    </div>
  </section>
</main>
