<header class="service-hero pt-20">
  <div class="max-w-5xl mx-auto px-6 py-16 md:py-20 text-center">
    <div class="inline-block px-4 py-1 rounded-full bg-white/10 text-spg-gold text-xs tracking-[2px] font-semibold mb-4">OFFICE • RETAIL • INDUSTRIAL</div>
    <h1 class="text-white text-6xl md:text-7xl tracking-[-2.6px] font-semibold">Property Maintenance Savannah</h1>
    <p class="max-w-xl mx-auto mt-5 text-xl text-white/75">Comprehensive building care programs that protect asset value and create safe, beautiful environments.</p>

    <div class="flex justify-center gap-3 mt-8">
      <button data-open-quote class="btn-gold px-8 py-3.5 rounded-2xl font-semibold">Get Maintenance Proposal</button>
      <a href="#services" class="inline-flex items-center px-8 py-3.5 rounded-2xl text-white border-2 border-white/40 hover:bg-white/10 transition">Browse Services</a>
    </div>
  </div>
</header>

<main>
  <h2 class="text-center text-3xl tracking-tight font-semibold text-spg-green mb-8">Why Choose Our Savannah Property Maintenance Team</h2>
  <!-- Services Grid -->
  <section id="services" class="bg-spg-sand py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-10">
        <div class="uppercase tracking-[3px] text-xs font-semibold text-spg-gold mb-3">OUR EXPERTISE</div>
        <h2 class="text-4xl font-semibold tracking-tight text-spg-green">Complete Property Maintenance</h2>
        <p class="mt-3 max-w-lg mx-auto text-spg-text-light">Click any service to learn more and request a quote for your specific property.</p>
      </div>

      {% set gridItems = [
        { href: "/property-maintenance-services/preventive-maintenance-programs/", key: "preventive", title: "Preventive Maintenance Programs", desc: "Scheduled inspections, tune-ups, and reporting that catch small issues before they become expensive problems." },
        { href: "/property-maintenance-services/grounds-and-landscaping-maintenance/", key: "grounds", title: "Grounds and Landscaping Maintenance", desc: "Mowing, landscaping, irrigation, tree care, and seasonal grounds upkeep for commercial properties." },
        { href: "/property-maintenance-services/roof-and-gutter-maintenance/", key: "roof", title: "Roof and Gutter Maintenance", desc: "Inspections, cleaning, repairs, coatings, and drainage maintenance that prevent leaks and extend roof life." },
        { href: "/property-maintenance-services/exterior-building-maintenance/", key: "exterior", title: "Exterior Building Maintenance", desc: "Facade cleaning, painting, sealing, caulking, and weatherproofing for the full building envelope." },
        { href: "/property-maintenance-services/mechanical-systems-maintenance/", key: "mechanical", title: "Mechanical Systems Maintenance", desc: "Ongoing care for HVAC, plumbing, electrical, and other building systems to ensure reliability and efficiency." },
        { href: "/property-maintenance-services/emergency-maintenance-response/", key: "emergency", title: "Emergency Maintenance Response", desc: "24/7 rapid response for urgent repairs, leaks, HVAC failures, storm damage, and after-hours issues." },
        { href: "/property-maintenance-services/residential-and-commercial-security/", key: "security2", title: "Residential & Commercial Security", desc: "Surveillance cameras, alarm systems, access control, smart locks, and monitoring for homes, offices, retail, and industrial properties." }
      ] %}
      {% include "service-grid.njk" %}
    </div>
  </section>

  <!-- FAQ -->
  {% set faq = pageData.faq %}
  {% include "faq.njk" %}
</main>
