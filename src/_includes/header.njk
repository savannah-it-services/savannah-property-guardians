<header class="navbar fixed top-0 left-0 right-0 z-50 border-b border-[#EDE4D4]">
  <nav class="max-w-7xl mx-auto px-6">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="{{ '/' | url }}" class="flex items-center gap-x-3 group">
        <svg class="nav-logo logo-svg" width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M22 3.5 L38 9.5 V21.5 C38 30.5 31.5 38.5 22 41.5 C12.5 38.5 6 30.5 6 21.5 V9.5 L22 3.5Z" fill="#1B4332"/>
          <path d="M22 3.5 L38 9.5 V21.5 C38 30.5 31.5 38.5 22 41.5 C12.5 38.5 6 30.5 6 21.5 V9.5 L22 3.5Z" stroke="#C9A227" stroke-width="2.5"/>
          <rect x="20" y="26" width="4" height="9" rx="1" fill="#C9A227"/>
          <ellipse cx="22" cy="23" rx="9" ry="5.5" fill="#C9A227"/>
          <ellipse cx="22" cy="17" rx="7" ry="5" fill="#C9A227"/>
          <ellipse cx="22" cy="12.5" rx="3.5" ry="2.5" fill="#C9A227"/>
        </svg>
        <div class="leading-none">
          <div class="font-semibold text-2xl tracking-tighter text-spg-green">Savannah</div>
          <div class="text-[10px] font-medium tracking-[3px] text-spg-gold -mt-1">PROPERTY GUARDIANS</div>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-x-9 text-sm font-medium">
        <a href="{{ '/handyman' | url }}" class="nav-link text-spg-text hover:text-spg-green">Handyman</a>
        <a href="{{ '/warehouse' | url }}" class="nav-link text-spg-text hover:text-spg-green">Warehouse</a>
        <a href="{{ '/maintenance' | url }}" class="nav-link text-spg-text hover:text-spg-green">Maintenance</a>
        <a href="{{ '/plumbing' | url }}" class="nav-link text-spg-text hover:text-spg-green">Plumbing</a>
        <a href="{{ '/about' | url }}" class="nav-link text-spg-text hover:text-spg-green">About</a>
      </div>

      <div class="hidden md:flex items-center gap-x-4">
        <a href="tel:{{ site.phoneHref }}" class="flex items-center gap-x-2 text-sm font-medium text-spg-text hover:text-spg-green transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/>
          </svg>
          <span>{{ site.phone }}</span>
        </a>
        <button data-open-quote class="btn-gold px-6 py-2.5 rounded-full text-sm font-semibold tracking-wide shadow-sm">
          Request Quote
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn"
              class="md:hidden flex items-center justify-center w-11 h-11 text-spg-green"
              aria-expanded="false"
              aria-label="Toggle navigation">
        <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
        </svg>
        <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="mobile-menu md:hidden bg-white border-t border-[#EDE4D4]">
    <div class="px-6 py-8 flex flex-col gap-y-5 text-base font-medium">
      <a href="{{ '/handyman' | url }}" class="nav-link text-spg-text py-1">Handyman Services</a>
      <a href="{{ '/warehouse' | url }}" class="nav-link text-spg-text py-1">Warehouse Management</a>
      <a href="{{ '/maintenance' | url }}" class="nav-link text-spg-text py-1">Property Maintenance</a>
      <a href="{{ '/plumbing' | url }}" class="nav-link text-spg-text py-1">Commercial Plumbing</a>
      <a href="{{ '/about' | url }}" class="nav-link text-spg-text py-1">About Us</a>
      
      <div class="pt-4 border-t border-[#EDE4D4] flex flex-col gap-y-3">
        <a href="tel:{{ site.phoneHref }}" class="text-spg-green font-semibold">{{ site.phone }}</a>
        <button data-open-quote class="btn-gold w-full py-3.5 rounded-2xl text-base font-semibold">
          Request a Free Quote
        </button>
      </div>
    </div>
  </div>
</header>