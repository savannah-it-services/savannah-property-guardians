<section id="faq" class="max-w-5xl mx-auto px-6 py-14">
  <div class="text-center mb-10">
    <div class="uppercase tracking-[2px] text-xs font-semibold text-spg-gold mb-3">QUESTIONS &amp; ANSWERS</div>
    <h2 class="text-spg-green text-3xl tracking-tight font-semibold">Frequently Asked Questions</h2>
  </div>

  <div class="faq max-w-3xl mx-auto">
    {% for item in faq %}
    <details name="faq" class="border-b border-[#EDE4D4] last:border-b-0 group">
      <summary class="flex items-start justify-between gap-4 py-4 cursor-pointer text-spg-green font-semibold text-[17px] leading-tight hover:text-spg-gold transition-colors list-none">
        {{ item.question }}
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-spg-gold shrink-0 mt-0.5 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke-width="2.75" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
        </svg>
      </summary>
      <div class="pb-6 pr-10 text-spg-text-light text-[15px] leading-relaxed">
        {{ item.answer }}
      </div>
    </details>
    {% endfor %}
  </div>
</section>
