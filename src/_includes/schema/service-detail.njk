{% set pageUrl = site.url ~ (page.url | replace('.html', '') | replace('/index', '')) %}
{% set ogImagePath = ogImage or site.ogImage %}
{% set serviceImage = site.url ~ ogImagePath %}
{% set serviceType = page.serviceType or (title | replace('Savannah ', '') | replace(' Installation & Repair', ' Services') | replace(' | ', ' - ') | replace(' Installation', ' Services') | replace(' Repair', ' Repairs') | replace(' & ', ' and ') ) %}
{% set priceRange = page.priceRange or "$$" %}
{% set reviewCount = reviews | length %}
{% set totalStars = 0 %}
{% for review in reviews %}
  {% set totalStars = totalStars + review.stars %}
{% endfor %}
{% set avgRating = (totalStars / reviewCount) | round(1) %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "{{ title }}",
  "description": "{{ description }}",
  "url": "{{ pageUrl }}",
  "image": "{{ serviceImage }}",
  "provider": {
    "@type": "ProfessionalService",
    "@id": "{{ site.url }}#business",
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "{{ avgRating }}",
      "bestRating": "5",
      "ratingCount": "{{ reviewCount }}"
    }
  },
  "areaServed": [
    { "@type": "City", "name": "Savannah" },
    { "@type": "City", "name": "Tybee Island" },
    { "@type": "AdministrativeArea", "name": "Chatham County" },
    { "@type": "AdministrativeArea", "name": "Coastal Georgia" }
  ],
  "serviceType": "{{ serviceType }}",
  "priceRange": "{{ priceRange }}",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "{{ title }}",
    "itemListElement": [
{% if page.offers %}
{% for offer in page.offers %}
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "{{ offer }}"
        }
      }{% if not loop.last %},{% endif %}
{% endfor %}
{% endif %}
    ]
  },
  "review": [
{% for review in reviews %}
    {
      "@type": "Review",
      "author": {
        "@type": "Person",
        "name": "{{ review.name }}"
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": "{{ review.stars }}",
        "bestRating": "5"
      },
      "reviewBody": "{{ review.quote | replace('“', '') | replace('”', '') | replace('"', '\\"') }}"
    }{% if not loop.last %},{% endif %}
{% endfor %}
  ]
}
</script>
