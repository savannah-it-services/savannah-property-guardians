{% set pageUrl = site.url ~ (page.url | replace('.html', '') | replace('/index', '')) %}
{% set ogImagePath = ogImage or site.ogImage %}
{% set serviceImage = site.url ~ ogImagePath %}
{% set serviceType = page.serviceType or (title | replace('Savannah ', '') | replace(' Installation & Repair', ' Services') | replace(' | ', ' - ') | replace(' Installation', ' Services') | replace(' Repair', ' Repairs') | replace(' & ', ' and ') ) %}
{% set priceRange = page.priceRange or "$$" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "{{ title }}",
  "description": "{{ description }}",
  "url": "{{ pageUrl }}",
  "image": "{{ serviceImage }}",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ pageUrl }}"
  },
  "provider": {
    "@type": "ProfessionalService",
    "@id": "{{ site.url }}#business"
  },
  "areaServed": [
    { "@type": "City", "name": "Savannah" },
    { "@type": "City", "name": "Tybee Island" },
    { "@type": "AdministrativeArea", "name": "Chatham County" },
    { "@type": "AdministrativeArea", "name": "Coastal Georgia" }
  ],
  "serviceType": "{{ serviceType }}",
  "priceRange": "{{ priceRange }}",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "{{ title }}",
    "itemListElement": [
{% if offers %}
{% for offer in offers %}
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "{{ offer }}"
        }
      }{% if not loop.last %},{% endif %}
{% endfor %}
{% endif %}
    ]
  }
}
</script>
