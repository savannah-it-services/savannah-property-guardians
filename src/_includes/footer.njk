<footer class="footer pt-16 pb-9">
  <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-12 gap-y-12 md:gap-x-8">
    <!-- Brand -->
    <div class="md:col-span-4">
      <div class="flex items-center gap-x-3 mb-5">
        <img src="{{ '/assets/images/logo/logo-icon.webp' | url }}" alt="Savannah Property Guardians logo" width="36" height="36">
        <span class="font-semibold tracking-tighter text-white text-2xl">Savannah Property Guardians</span>
      </div>
      <p class="text-[#C5C2B8] max-w-xs">Professional handyman, plumbing, warehouse, and property maintenance proudly serving Savannah, Tybee Island, and Chatham County, GA.</p>
    </div>

    <!-- Services -->
    <div class="md:col-span-4">
      <div class="text-sm md:pl-2">
        <div>
          <div class="font-semibold text-white mb-3 tracking-wider text-xs">SERVICES</div>
          <div class="space-y-0 text-[#C5C2B8]">
            <!-- Handyman -->
            <details name="footer-services">
              <summary class="flex items-center justify-between py-1 cursor-pointer hover:text-white">
                <span class="font-medium">Handyman</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </summary>
              <div class="sub-services">
                <a href="{{ '/handyman' | url | cleanUrl }}">View all Handyman Services</a>
                <a href="/handyman-services/door-and-window-installation-and-repairs">Door &amp; Window Installation &amp; Repairs</a>
                <a href="/handyman-services/flooring-and-tile-installation-and-repairs">Flooring &amp; Tile Installation &amp; Repairs</a>
                <a href="/handyman-services/gutter-installation-and-repair">Gutter Installation &amp; Repair</a>
                <a href="/handyman-services/professional-painting-and-waterproofing">Professional Painting &amp; Waterproofing</a>
                <a href="/handyman-services/expert-fencing">Expert Fencing</a>
                <a href="/handyman-services/drywall-repair-and-installation">Drywall Repair &amp; Installation</a>
                <a href="/handyman-services/quality-carpentry-work">Quality Carpentry Work</a>
                <a href="/handyman-services/lighting-and-electrical">Lighting &amp; Electrical</a>
                <a href="/handyman-services/home-security">Home Security</a>
              </div>
            </details>

            <!-- Warehouse Management -->
            <details name="footer-services">
              <summary class="flex items-center justify-between py-1 cursor-pointer hover:text-white">
                <span class="font-medium">Warehouse Management</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </summary>
              <div class="sub-services">
                <a href="{{ '/warehouse' | url | cleanUrl }}">View all Warehouse Services</a>
                <a href="/warehouse-services/exterior-warehouse-maintenance">Exterior Warehouse Maintenance</a>
                <a href="/warehouse-services/rack-and-shelving-installation">Rack &amp; Shelving Installation</a>
                <a href="/warehouse-services/industrial-lighting-and-electrical">Industrial Lighting and Electrical</a>
                <a href="/warehouse-services/floor-maintenance-and-repair">Floor Maintenance and Repair</a>
                <a href="/warehouse-services/hvac-and-climate-control">HVAC and Climate Control</a>
                <a href="/warehouse-services/warehouse-security">Warehouse Security</a>
                <a href="/warehouse-services/interior-office-maintenance">Interior Office Maintenance</a>
              </div>
            </details>

            <!-- Property Maintenance -->
            <details name="footer-services">
              <summary class="flex items-center justify-between py-1 cursor-pointer hover:text-white">
                <span class="font-medium">Property Maintenance</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </summary>
              <div class="sub-services">
                <a href="{{ '/property-maintenance' | url | cleanUrl }}">View all Property Maintenance</a>
                <a href="/property-maintenance-services/preventive-maintenance-programs">Preventive Maintenance Programs</a>
                <a href="/property-maintenance-services/grounds-and-landscaping-maintenance">Grounds and Landscaping Maintenance</a>
                <a href="/property-maintenance-services/roof-and-gutter-maintenance">Roof and Gutter Maintenance</a>
                <a href="/property-maintenance-services/exterior-building-maintenance">Exterior Building Maintenance</a>
                <a href="/property-maintenance-services/mechanical-systems-maintenance">Mechanical Systems Maintenance</a>
                <a href="/property-maintenance-services/emergency-maintenance-response">Emergency Maintenance Response</a>
                <a href="/property-maintenance-services/residential-and-commercial-security">Residential &amp; Commercial Security</a>
              </div>
            </details>

            <!-- Commercial Plumbing -->
            <details name="footer-services">
              <summary class="flex items-center justify-between py-1 cursor-pointer hover:text-white">
                <span class="font-medium">Commercial Plumbing</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 transition-transform" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                </svg>
              </summary>
              <div class="sub-services">
                <a href="{{ '/plumbing' | url | cleanUrl }}">View all Commercial Plumbing</a>
                <a href="/plumbing-services/plumbing-emergencies">Plumbing Emergencies</a>
                <a href="/plumbing-services/leaks-and-drains">Leaks and Drains</a>
                <a href="/plumbing-services/new-construction">New Construction</a>
                <a href="/plumbing-services/water-heaters">Water Heaters</a>
                <a href="/plumbing-services/water-pressure">Water Pressure</a>
                <a href="/plumbing-services/waste-removal">Waste Removal</a>
              </div>
            </details>

            <a href="{{ '/about' | url | cleanUrl }}" class="block py-1 font-medium hover:text-white">About</a>
            <a href="{{ '/contact' | url | cleanUrl }}" class="block py-1 font-medium hover:text-white">Contact</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact -->
    <div class="md:col-span-4">
      <div class="text-sm md:pl-2">
        <div>
          <div class="font-semibold text-white mb-4 tracking-wider text-xs">CONTACT</div>
          <div class="space-y-2 text-[#C5C2B8]">
            <div>
              <a href="tel:{{ site.phoneHref }}" class="block hover:text-white font-medium">{{ site.phone }}</a>
              <div class="text-[10px] tracking-wider -mt-0.5">24/7 EMERGENCY</div>
            </div>

            <a href="mailto:{{ site.email }}" class="block hover:text-white">{{ site.email }}</a>

            <div class="leading-snug">
              {{ site.business_address.street1 }}<br>
              {% if site.business_address.street2 %}{{ site.business_address.street2 }}<br>{% endif %}
              {{ site.business_address.city }}, {{ site.business_address.state }} {{ site.business_address.zip }}
            </div>

            <a href="/privacy-policy" class="block text-sm text-[#C5C2B8] hover:text-white mt-2">Privacy Policy</a>

            <div class="mt-2">
              {% include "social-icons.njk" %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 mt-16 pt-8 border-t border-white/10 text-xs text-[#A19E94]">
    <div class="text-center">
      © <span id="current-year"></span> Savannah Property Guardians, LLC. All rights reserved.
      <span class="mx-1">|</span>
      <a href="/privacy-policy" class="hover:text-white">Privacy Policy</a>
    </div>
  </div>
</footer>
