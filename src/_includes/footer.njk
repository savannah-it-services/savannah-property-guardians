<footer class="footer pt-16 pb-9">
  <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-12 gap-y-12 md:gap-x-8">
    <!-- Brand -->
    <div class="md:col-span-4">
      <div class="flex items-center gap-x-3 mb-5">
        <img src="{{ '/assets/images/logo/logo-icon.png' | url }}" alt="Savannah Property Guardians logo" width="36" height="36">
        <span class="font-semibold tracking-tighter text-white text-2xl">Savannah Property Guardians</span>
      </div>
      <p class="text-[#C5C2B8] max-w-xs">Professional handyman, plumbing, warehouse, and property maintenance proudly serving Savannah, Tybee Island, and Chatham County, GA.</p>
    </div>

    <!-- Services -->
    <div class="md:col-span-4">
      <div class="text-sm md:pl-2">
        <div>
          <div class="font-semibold text-white mb-4 tracking-wider text-xs">SERVICES</div>
          <div class="space-y-2">
            <a href="{{ '/handyman' | url }}" class="block hover:text-white">Handyman</a>
            <a href="{{ '/warehouse' | url }}" class="block hover:text-white">Warehouse Management</a>
            <a href="{{ '/property-maintenance' | url }}" class="block hover:text-white">Property Maintenance</a>
            <a href="{{ '/plumbing' | url }}" class="block hover:text-white">Commercial Plumbing</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact -->
    <div class="md:col-span-4">
      <div class="text-sm md:pl-2">
        <div>
          <div class="font-semibold text-white mb-4 tracking-wider text-xs">CONTACT</div>
          <div class="space-y-2 text-[#C5C2B8]">
            <div>
              <a href="tel:{{ site.phoneHref }}" class="block hover:text-white font-medium">{{ site.phone }}</a>
              <div class="text-[10px] tracking-wider -mt-0.5">24/7 EMERGENCY</div>
            </div>

            <a href="mailto:{{ site.email }}" class="block hover:text-white">{{ site.email }}</a>

            <div class="leading-snug">
              {{ site.business_address.street1 }}<br>
              {% if site.business_address.street2 %}{{ site.business_address.street2 }}<br>{% endif %}
              {{ site.business_address.city }}, {{ site.business_address.state }} {{ site.business_address.zip }}
            </div>

            <a href="/privacy-policy/" class="block text-sm text-[#C5C2B8] hover:text-white mt-2">Privacy Policy</a>

            <a href="{{ site.google_business_profile }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-x-2 text-sm text-[#C5C2B8] hover:text-white mt-1" aria-label="View our Google Business Profile and reviews">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 flex-shrink-0" viewBox="0 0 48 48" aria-hidden="true">
                <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20c11.045 0 20-8.955 20-20 0-1.341-.138-2.65-.389-3.917z"/>
                <path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/>
                <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
                <path fill="#1976D2" d="M43.611 20.083L43.595 20 42 20H24v8h11.303c-.792 2.237-2.231 4.166-4.087 5.571.001-.001.002-.001.003-.002l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
              </svg>
              <span>Google Business Profile</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 mt-16 pt-8 border-t border-white/10 text-xs text-[#A19E94]">
    <div class="text-center">
      © <span id="current-year"></span> Savannah Property Guardians, LLC. All rights reserved.
      <span class="mx-1">|</span>
      <a href="/privacy-policy/" class="hover:text-white">Privacy Policy</a>
    </div>
  </div>
</footer>