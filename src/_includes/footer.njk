<footer class="footer pt-16 pb-9">
  <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-12 gap-y-12 md:gap-x-8">
    <!-- Brand -->
    <div class="md:col-span-4">
      <div class="flex items-center gap-x-3 mb-5">
        <svg width="36" height="36" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M22 3.5 L38 9.5 V21.5 C38 30.5 31.5 38.5 22 41.5 C12.5 38.5 6 30.5 6 21.5 V9.5 L22 3.5Z" fill="#C9A227"/>
          <rect x="20" y="26" width="4" height="9" rx="1" fill="#1B4332"/>
          <ellipse cx="22" cy="23" rx="9" ry="5.5" fill="#1B4332"/>
          <ellipse cx="22" cy="17" rx="7" ry="5" fill="#1B4332"/>
        </svg>
        <span class="font-semibold tracking-tighter text-white text-2xl">Savannah Property Guardians</span>
      </div>
      <p class="text-[#C5C2B8] max-w-xs">Professional property guardianship and maintenance throughout Georgia, South Carolina, and North Carolina.</p>
    </div>

    <!-- Services -->
    <div class="md:col-span-4">
      <div class="text-sm md:pl-2">
        <div>
          <div class="font-semibold text-white mb-4 tracking-wider text-xs">SERVICES</div>
          <div class="space-y-2">
            <a href="{{ '/handyman' | url }}" class="block hover:text-white">Handyman</a>
            <a href="{{ '/warehouse' | url }}" class="block hover:text-white">Warehouse Management</a>
            <a href="{{ '/maintenance' | url }}" class="block hover:text-white">Property Maintenance</a>
            <a href="{{ '/plumbing' | url }}" class="block hover:text-white">Commercial Plumbing</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact -->
    <div class="md:col-span-4">
      <div class="text-sm md:pl-2">
        <div>
          <div class="font-semibold text-white mb-4 tracking-wider text-xs">CONTACT</div>
          <div class="space-y-2 text-[#C5C2B8]">
            <div>
              <a href="tel:{{ site.phoneHref }}" class="block hover:text-white font-medium">{{ site.phone }}</a>
              <div class="text-[10px] tracking-wider -mt-0.5">24/7 EMERGENCY</div>
            </div>

            <a href="mailto:{{ site.email }}" class="block hover:text-white">{{ site.email }}</a>

            <div class="leading-snug">
              {{ site.business_address.street1 }}<br>
              {{ site.business_address.city }}, {{ site.business_address.state }} {{ site.business_address.zip }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 mt-16 pt-8 border-t border-white/10 text-xs text-[#A19E94]">
    <div class="text-center">© <span id="current-year"></span> Savannah Property Guardians, LLC. All rights reserved.</div>
  </div>
</footer>