<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or 'Savannah handyman services, commercial plumbing, warehouse maintenance, and property maintenance in Savannah, Tybee Island, and Chatham County, GA. 100% veteran-owned. Free quotes and 24/7 emergency response.' }}">
  <title>{{ title or 'Savannah Property Guardians' }}</title>

  <!-- Google Analytics (GA4) -->
  {%- if site.google_measurement_id %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.google_measurement_id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ site.google_measurement_id }}');
  </script>
  {%- endif %}

  <!-- HubSpot Tracking Code (for form submissions, analytics, and context) -->
  {%- if site.hubspot_portal_id %}
  <script type="text/javascript" id="hs-script-loader" async defer src="//js.hs-scripts.com/{{ site.hubspot_portal_id }}.js"></script>
  {%- endif %}

  <!-- Open Graph / Social Previews -->
  {% set ogTitle = title or site.name %}
  {% set ogDescription = description or site.description %}
  {% set ogImagePath = ogImage or site.ogImage %}
  {% set ogImageUrl = site.url ~ ogImagePath %}
  {% set cleanPath = (page.url or '/') | replace('.html', '') %}
  {% if cleanPath.length > 1 and cleanPath.endsWith('/') %}
    {% set cleanPath = cleanPath.slice(0, -1) %}
  {% endif %}
  {% if not cleanPath or cleanPath == '' %}{% set cleanPath = '/' %}{% endif %}
  {% set ogUrl = site.url ~ cleanPath %}
  <meta property="og:title" content="{{ ogTitle }}">
  <meta property="og:description" content="{{ ogDescription }}">
  <meta property="og:url" content="{{ ogUrl }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:image" content="{{ ogImageUrl }}">
  <meta property="og:image:alt" content="{{ site.ogImageAlt or ogTitle }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="en_US">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ ogTitle }}">
  <meta name="twitter:description" content="{{ ogDescription }}">
  <meta name="twitter:image" content="{{ ogImageUrl }}">
  <meta name="twitter:image:alt" content="{{ site.ogImageAlt or ogTitle }}">

  <!-- JSON-LD Schema: LocalBusiness (global for all pages) - Optimized for Savannah local SEO -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "{{ site.url }}#business",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}",
    "logo": "{{ site.url }}{{ site.ogImage }}",
    "image": "{{ site.url }}{{ site.ogImage }}",
    "description": "{{ site.description }}",
    "slogan": "Protecting properties across Savannah and coastal Georgia since 2014",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.business_address.street1 }}{% if site.business_address.street2 %}, {{ site.business_address.street2 }}{% endif %}",
      "addressLocality": "{{ site.business_address.city }}",
      "addressRegion": "{{ site.business_address.state }}",
      "postalCode": "{{ site.business_address.zip }}",
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": {{ site.geo.latitude }},
      "longitude": {{ site.geo.longitude }}
    },
    "telephone": "{{ site.phone }}",
    "email": "{{ site.email }}",
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday"
      ],
      "opens": "07:00",
      "closes": "18:00"
    },
    "areaServed": [
      {
        "@type": "City",
        "name": "Savannah",
        "sameAs": "https://en.wikipedia.org/wiki/Savannah,_Georgia"
      },
      {
        "@type": "City",
        "name": "Tybee Island"
      },
      {
        "@type": "AdministrativeArea",
        "name": "Chatham County"
      },
      {
        "@type": "AdministrativeArea",
        "name": "Coastal Georgia"
      }
    ],
    "knowsAbout": [
      "Savannah handyman services",
      "Chatham County property maintenance",
      "Tybee Island warehouse management",
      "Savannah GA plumbing",
      "Commercial electrician Savannah"
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Property Care Services",
      "itemListElement": [
        {
          "@type": "OfferCatalog",
          "name": "Handyman Services",
          "url": "{{ site.url }}/handyman"
        },
        {
          "@type": "OfferCatalog",
          "name": "Warehouse Management",
          "url": "{{ site.url }}/warehouse"
        },
        {
          "@type": "OfferCatalog",
          "name": "Property Maintenance",
          "url": "{{ site.url }}/property-maintenance"
        },
        {
          "@type": "OfferCatalog",
          "name": "Commercial Plumbing",
          "url": "{{ site.url }}/plumbing"
        }
      ]
    }
  }
  </script>

  {% block additional_schema %}{% endblock %}

  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
  <link rel="sitemap" type="application/xml" title="Sitemap" href="{{ '/sitemap.xml' | url }}">
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <!-- Fallback SVG favicon for modern browsers -->
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Cpath d='M50 8 L85 20 V45 C85 68 70 85 50 92 C30 85 15 68 15 45 V20 L50 8Z' fill='%231B4332'/%3E%3Cpath d='M50 8 L85 20 V45 C85 68 70 85 50 92 C30 85 15 68 15 45 V20 L50 8Z' stroke='%23C9A227' stroke-width='4'/%3E%3Crect x='46' y='55' width='8' height='18' rx='2' fill='%23C9A227'/%3E%3Cellipse cx='50' cy='50' rx='18' ry='10' fill='%23C9A227'/%3E%3Cellipse cx='50' cy='38' rx='12' ry='8' fill='%23C9A227'/%3E%3Cellipse cx='50' cy='28' rx='6' ry='4' fill='%23C9A227'/%3E%3C/svg%3E" type="image/svg+xml">
</head>
<body class="antialiased">
  {% include "header.njk" %}

  {{ content | safe }}

  <!-- Global Contact / Quote Form -->
  <section id="contact-form" class="bg-white py-16 border-y border-[#EDE4D4]">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-10">
        <div class="uppercase tracking-[3px] text-xs font-semibold text-spg-gold mb-3">GET A QUOTE</div>
        <h2 class="text-4xl font-semibold tracking-tight text-spg-green">Ready to protect your property?</h2>
        <p class="mt-3 text-spg-text-light max-w-md mx-auto">Tell us about your project. Quotes are always free and we'll get back to you promptly.</p>
      </div>

      <div class="bg-spg-sand border border-[#EDE4D4] rounded-3xl overflow-hidden">
        {% include "quote-form.njk" %}
      </div>
    </div>
  </section>

  {% include "footer.njk" %}

  <script src="{{ '/assets/js/script.js' | url }}"></script>
</body>
</html>