<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Silence a harmless Chrome DevTools internal error that some analytics scripts (like HubSpot) can trigger in local dev.
       Using defineProperty with a getter ensures it always returns a function even if later code tries to overwrite it. -->
  <script>
    try {
      Object.defineProperty(window, '__chromium_devtools_metrics_reporter', {
        configurable: true,
        enumerable: true,
        get: function() { return function() {}; },
        set: function() {}
      });
    } catch (e) {}
  </script>
  <meta name="description" content="{{ description or 'Savannah handyman services, commercial plumbing, warehouse maintenance, and property maintenance in Savannah, Tybee Island, and Chatham County, GA. 100% veteran-owned. Free quotes and 24/7 emergency response.' }}">
  <title>{{ title or 'Savannah Property Guardians' }}</title>

  <!-- Google Tag Manager -->
  {%- if site.isProduction === true %}
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','{{ site.google_tag_manager_id }}');</script>
  {%- endif %}
  <!-- End Google Tag Manager -->

  <!-- HubSpot Tracking Code (for form submissions, analytics, and context) -->
  {%- if site.hubspot_portal_id %}
  <!-- Extra guard right before HubSpot in case of async timing issues -->
  <script>
    try {
      Object.defineProperty(window, '__chromium_devtools_metrics_reporter', {
        configurable: true,
        enumerable: true,
        get: function() { return function() {}; },
        set: function() {}
      });
    } catch (e) {}
  </script>
  <script type="text/javascript" id="hs-script-loader" async defer src="//js.hs-scripts.com/{{ site.hubspot_portal_id }}.js"></script>
  {%- endif %}

  <!-- Open Graph / Social Previews -->
  {% set ogTitle = title or site.name %}
  {% set ogDescription = description or site.description %}
  {% set ogImagePath = ogImage or site.ogImage %}
  {% set ogImageUrl = site.url ~ ogImagePath %}
  {% set cleanPath = page.url | cleanUrl %}
  {% set ogUrl = site.url ~ cleanPath %}
  <meta property="og:title" content="{{ ogTitle }}">
  <meta property="og:description" content="{{ ogDescription }}">
  <meta property="og:url" content="{{ ogUrl }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:image" content="{{ ogImageUrl }}">
  <meta property="og:image:alt" content="{{ site.ogImageAlt or ogTitle }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="en_US">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ ogTitle }}">
  <meta name="twitter:description" content="{{ ogDescription }}">
  <meta name="twitter:image" content="{{ ogImageUrl }}">
  <meta name="twitter:image:alt" content="{{ site.ogImageAlt or ogTitle }}">

  <!-- Self-referencing canonical URL -->
  <link rel="canonical" href="{{ ogUrl }}">

  <!-- JSON-LD Schema: LocalBusiness (global for all pages) - Optimized for Savannah local SEO -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "{{ site.url }}#business",
    "name": "{{ site.name | safe }}",
    "url": "{{ site.url }}",
    "logo": "{{ site.url }}{{ site.ogImage }}",
    "image": "{{ site.url }}{{ site.ogImage }}",
    "description": "{{ site.description | safe }}",
    "slogan": "Protecting properties across Savannah and coastal Georgia since 2014",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.business_address.street1 }}{% if site.business_address.street2 %}, {{ site.business_address.street2 }}{% endif %}",
      "addressLocality": "{{ site.business_address.city }}",
      "addressRegion": "{{ site.business_address.state }}",
      "postalCode": "{{ site.business_address.zip }}",
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": {{ site.geo.latitude }},
      "longitude": {{ site.geo.longitude }}
    },
    "telephone": "{{ site.phone }}",
    "email": "{{ site.email }}",
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday"
        ],
        "opens": "07:00",
        "closes": "18:00"
      },
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": "Saturday",
        "opens": "09:00",
        "closes": "16:00"
      }
    ],
    "areaServed": [
      {
        "@type": "City",
        "name": "Savannah",
        "sameAs": "https://en.wikipedia.org/wiki/Savannah,_Georgia"
      },
      {
        "@type": "City",
        "name": "Tybee Island"
      },
      {
        "@type": "AdministrativeArea",
        "name": "Chatham County"
      },
      {
        "@type": "AdministrativeArea",
        "name": "Coastal Georgia"
      }
    ],
    "knowsAbout": [
      "Savannah handyman services",
      "Chatham County property maintenance",
      "Tybee Island warehouse management",
      "Savannah GA plumbing",
      "Commercial electrician Savannah"
    ],
    "sameAs": [
      "{{ site.social.facebook }}",
      "{{ site.social.instagram }}",
      "{{ site.social.x }}",
      "{{ site.social.google_business }}"
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Property Care Services",
      "itemListElement": [
        {
          "@type": "OfferCatalog",
          "name": "Handyman Services",
          "url": "{{ site.url }}/handyman"
        },
        {
          "@type": "OfferCatalog",
          "name": "Warehouse Management",
          "url": "{{ site.url }}/warehouse"
        },
        {
          "@type": "OfferCatalog",
          "name": "Property Maintenance",
          "url": "{{ site.url }}/property-maintenance"
        },
        {
          "@type": "OfferCatalog",
          "name": "Commercial Plumbing",
          "url": "{{ site.url }}/plumbing"
        }
      ]
    }
  }
  </script>

  <!-- WebSite schema with SearchAction for sitelinks searchbox -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "url": "{{ site.url }}",
    "name": "{{ site.name | safe }}",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "{{ site.url }}/?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  }
  </script>

  <!-- BreadcrumbList for all pages - hierarchical -->
  {% set cleanPath = page.url | cleanUrl %}
  {% set crumbs = [{ "pos": 1, "name": "Home", "url": site.url }] %}
  {% set pos = 2 %}

  {% if cleanPath != '/' %}
    {# Add parent level for service detail sections #}
    {% set segments = cleanPath.split('/') %}
    {% set firstSegment = segments[1] | default('') %}
    {% set isServiceDetail = false %}

    {% if firstSegment == 'handyman-services' %}
      {% set crumbs = crumbs.concat([{ "pos": pos, "name": "Handyman Services", "url": site.url ~ "/handyman" }]) %}
      {% set pos = pos + 1 %}
      {% set isServiceDetail = true %}
    {% elif firstSegment == 'plumbing-services' %}
      {% set crumbs = crumbs.concat([{ "pos": pos, "name": "Commercial Plumbing", "url": site.url ~ "/plumbing" }]) %}
      {% set pos = pos + 1 %}
      {% set isServiceDetail = true %}
    {% elif firstSegment == 'property-maintenance-services' %}
      {% set crumbs = crumbs.concat([{ "pos": pos, "name": "Property Maintenance", "url": site.url ~ "/property-maintenance" }]) %}
      {% set pos = pos + 1 %}
      {% set isServiceDetail = true %}
    {% elif firstSegment == 'warehouse-services' %}
      {% set crumbs = crumbs.concat([{ "pos": pos, "name": "Warehouse Management", "url": site.url ~ "/warehouse" }]) %}
      {% set pos = pos + 1 %}
      {% set isServiceDetail = true %}
    {% endif %}

    {# Determine best name for the current page #}
    {% set currentName = title | default('Page') %}

    {# Prefer short serviceType for detail pages when available (use bare var to match how title works) #}
    {% if serviceType %}
      {% set currentName = serviceType %}
    {% endif %}

    {# Provide clean short names for top-level category and other pages #}
    {% if cleanPath == '/handyman' %}
      {% set currentName = "Handyman Services" %}
    {% elif cleanPath == '/plumbing' %}
      {% set currentName = "Commercial Plumbing" %}
    {% elif cleanPath == '/property-maintenance' %}
      {% set currentName = "Property Maintenance" %}
    {% elif cleanPath == '/warehouse' %}
      {% set currentName = "Warehouse Management" %}
    {% elif cleanPath == '/about' %}
      {% set currentName = "About" %}
    {% elif cleanPath == '/contact' %}
      {% set currentName = "Contact" %}
    {% elif cleanPath == '/privacy-policy' %}
      {% set currentName = "Privacy Policy" %}
    {% endif %}

    {# For service detail pages, ensure we have a clean leaf name #}
    {% if isServiceDetail %}
      {% if serviceType %}
        {% set currentName = serviceType %}
      {% else %}
        {# Light cleanup of the page title #}
        {% set currentName = currentName | replace('Savannah ', '') | replace(' |.*', '') %}
      {% endif %}
    {% endif %}

    {% set crumbs = crumbs.concat([{ "pos": pos, "name": currentName, "url": site.url ~ cleanPath }]) %}
  {% endif %}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {% for crumb in crumbs %}
      {
        "@type": "ListItem",
        "position": {{ crumb.pos }},
        "name": "{{ crumb.name | safe }}",
        "item": "{{ crumb.url | safe }}"
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>

  {% block additional_schema %}{% endblock %}

  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
  <link rel="sitemap" type="application/xml" title="Sitemap" href="{{ '/sitemap.xml' | url }}">

  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <!-- Fallback SVG favicon for modern browsers -->
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Cpath d='M50 8 L85 20 V45 C85 68 70 85 50 92 C30 85 15 68 15 45 V20 L50 8Z' fill='%231B4332'/%3E%3Cpath d='M50 8 L85 20 V45 C85 68 70 85 50 92 C30 85 15 68 15 45 V20 L50 8Z' stroke='%23C9A227' stroke-width='4'/%3E%3Crect x='46' y='55' width='8' height='18' rx='2' fill='%23C9A227'/%3E%3Cellipse cx='50' cy='50' rx='18' ry='10' fill='%23C9A227'/%3E%3Cellipse cx='50' cy='38' rx='12' ry='8' fill='%23C9A227'/%3E%3Cellipse cx='50' cy='28' rx='6' ry='4' fill='%23C9A227'/%3E%3C/svg%3E" type="image/svg+xml">
</head>
<body class="antialiased">
  <!-- Google Tag Manager (noscript) -->
  {%- if site.isProduction === true %}
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ site.google_tag_manager_id }}"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  {%- endif %}
  <!-- End Google Tag Manager (noscript) -->

  {% include "header.njk" %}

  {{ content | safe }}

  <!-- Global Contact / Quote Form -->
  <section id="contact-form" class="bg-white py-16 border-y border-[#EDE4D4]">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-10">
        <div class="uppercase tracking-[3px] text-xs font-semibold text-spg-gold mb-3">GET A QUOTE</div>
        <h2 class="text-4xl font-semibold tracking-tight text-spg-green">Ready to protect your property?</h2>
        <p class="mt-3 text-spg-text-light max-w-md mx-auto">Tell us about your project. Quotes are always free and we'll get back to you promptly.</p>
      </div>

      <div class="bg-spg-sand border border-[#EDE4D4] rounded-3xl overflow-hidden">
        {% include "quote-form.njk" %}
      </div>
    </div>
  </section>

  {% include "footer.njk" %}

  <!-- Mobile-only fixed bottom action bar: Request Quote (scrolls to form) + phone link -->
  <!-- Matches header styling (white/blur bg, border, spg-green text) but for mobile CTAs only.
       Left action left-aligned to match logo left edge; right action right-aligned to match mobile menu button. -->
  <div class="mobile-cta-bar fixed bottom-0 left-0 right-0 z-40 md:hidden border-t border-[#EDE4D4] bg-white/95 backdrop-blur-md">
    <div class="h-14 flex items-center justify-between max-w-7xl mx-auto px-6">
      <!-- Left: Request Quote (left-aligned to logo) -->
      <button data-open-quote
              class="group h-full flex items-center gap-x-2 text-base font-semibold text-spg-green active:opacity-75 transition-opacity focus:outline-none focus-visible:ring-1 focus-visible:ring-spg-gold/60 cursor-pointer pl-0 pr-4">
        <span class="relative inline-block w-4 h-4 flex-shrink-0">
          <!-- Default icon (quote/document) -->
          <svg xmlns="http://www.w3.org/2000/svg" class="quote-default absolute inset-0 w-full h-full transition-opacity duration-150 group-hover:opacity-0" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
          <!-- Hover icon: hand -->
          <svg xmlns="http://www.w3.org/2000/svg" class="hand-hover absolute inset-0 w-full h-full opacity-0 transition-all duration-150 group-hover:opacity-100 group-hover:scale-110" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v0M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v2M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15" />
          </svg>
        </span>
        <span>Request Quote</span>
      </button>

      <!-- Right: Phone link (right-aligned to menu icon) -->
      <a href="tel:{{ site.phoneHref }}"
         class="h-full flex items-center gap-x-2 text-base font-semibold text-spg-green active:opacity-75 transition-opacity focus:outline-none focus-visible:ring-1 focus-visible:ring-spg-gold/60 pl-4 pr-0"
         aria-label="Call {{ site.phone }}">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/>
        </svg>
        <span>{{ site.phone }}</span>
      </a>
    </div>
  </div>

  <script src="{{ '/assets/js/script.js' | url }}"></script>
</body>
</html>
