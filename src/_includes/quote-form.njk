<form id="quote-form" name="quote-request-form" method="POST"
      data-hubspot-portal-id="{{ site.hubspot_portal_id }}"
      data-hubspot-form-guid="{{ site.hubspot_quote_form_guid }}">
  <div class="px-7 py-7 space-y-5">
    <div class="grid grid-cols-2 gap-5">
      <div>
        <label for="firstname" class="text-sm font-medium block mb-1.5">First Name *</label>
        <input id="firstname" required type="text" name="firstname" class="form-input w-full rounded-2xl px-4 py-3 text-sm" placeholder="Jane">
      </div>
      <div>
        <label for="lastname" class="text-sm font-medium block mb-1.5">Last Name *</label>
        <input id="lastname" required type="text" name="lastname" class="form-input w-full rounded-2xl px-4 py-3 text-sm" placeholder="Cooper">
      </div>
    </div>

    <div class="grid grid-cols-2 gap-5">
      <div>
        <label for="phone" class="text-sm font-medium block mb-1.5">Phone Number *</label>
        <input id="phone" required type="tel" name="phone" class="form-input w-full rounded-2xl px-4 py-3 text-sm" placeholder="(555) 123-4567">
      </div>
      <div>
        <label for="company" class="text-sm font-medium block mb-1.5">Company</label>
        <input id="company" type="text" name="company" class="form-input w-full rounded-2xl px-4 py-3 text-sm" placeholder="Acme Distribution LLC">
      </div>
    </div>

    <div>
      <label for="email" class="text-sm font-medium block mb-1.5">Email Address *</label>
      <input id="email" required type="email" name="email" class="form-input w-full rounded-2xl px-4 py-3 text-sm" placeholder="you@company.com">
    </div>

    <div>
      <label for="details" class="text-sm font-medium block mb-1.5">Tell us about the project *</label>
      <textarea id="details" required name="details" rows="3" class="form-input w-full rounded-3xl px-4 py-3 text-sm resize-y" placeholder="Please describe the scope, timeline, and any special requirements..."></textarea>
    </div>

    <div class="pt-3">
      <button type="submit" class="btn-primary w-full text-white py-[17px] font-semibold rounded-2xl text-base tracking-wider">
        SUBMIT REQUEST
      </button>
    </div>
  </div>
</form>

<div id="quote-success" class="hidden px-8 py-14 text-center">
  <div class="mx-auto w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-6">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
    </svg>
  </div>
  <h3 class="text-2xl font-semibold text-spg-green">Thank you!</h3>
  <p class="mt-3 text-spg-text-light max-w-[260px] mx-auto">Your quote request has been received. A member of our team will contact you shortly.</p>
</div>
