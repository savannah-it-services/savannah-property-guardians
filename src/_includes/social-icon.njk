{#
  Reusable single social media icon.

  Usage (pass the URL explicitly so it works reliably in any context):
    {% from "social-icon.njk" import social_icon %}
    {{ social_icon('google', site.social.google_business) }}
    {{ social_icon('facebook', site.social.facebook, 'w-6 h-6') }}   (optional extra classes on the <a>)

  Supported names: 'google' (or 'g'), 'facebook', 'instagram', 'x' (or 'twitter')
#}

{% macro social_icon(name, url, class='') %}
  {% set base = 'hover:opacity-80 transition-opacity ' + class %}
  {% if name == 'google' or name == 'g' %}
    <a href="{{ url }}" target="_blank" rel="noopener noreferrer" class="{{ base }}" aria-label="Google Business Profile">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 flex-shrink-0" viewBox="0 0 48 48" aria-hidden="true">
        <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20c11.045 0 20-8.955 20-20 0-1.341-.138-2.65-.389-3.917z"/>
        <path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/>
        <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
        <path fill="#1976D2" d="M43.611 20.083L43.595 20 42 20H24v8h11.303c-.792 2.237-2.231 4.166-4.087 5.571.001-.001.002-.001.003-.002l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
      </svg>
    </a>
  {% elif name == 'facebook' %}
    <a href="{{ url }}" target="_blank" rel="noopener noreferrer" class="{{ base }}" aria-label="Facebook">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 flex-shrink-0" fill="#1877F2" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
      </svg>
    </a>
  {% elif name == 'instagram' %}
    <a href="{{ url }}" target="_blank" rel="noopener noreferrer" class="{{ base }}" aria-label="Instagram">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 flex-shrink-0" fill="#E4405F" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.849.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.405a1.44 1.44 0 01-.88-1.44 1.44 1.44 0 011.44-.88 1.44 1.44 0 011.44.88 1.44 1.44 0 01-.88 1.44z"/>
      </svg>
    </a>
  {% elif name == 'x' or name == 'twitter' %}
    <a href="{{ url }}" target="_blank" rel="noopener noreferrer" class="{{ base }}" aria-label="X">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M18.244 2.25l-7.451 8.52L4.5 2.25H1.5l7.5 9L1.5 21.75h3l5.25-6.75L18 21.75h3l-7.5-9 7.5-9z"/>
      </svg>
    </a>
  {% else %}
    {# Unknown platform - render nothing #}
  {% endif %}
{% endmacro %}