<!-- Request a Quote Modal -->
<div id="quote-modal" class="hidden fixed inset-0 z-[70] items-center justify-center bg-black/70 p-5">
  <div id="modal-backdrop" class="absolute inset-0"></div>
  
  <div class="modal relative w-full max-w-lg bg-white rounded-3xl shadow-2xl overflow-hidden">
    <div class="flex items-center justify-between px-7 pt-6 pb-4 border-b">
      <div>
        <div class="font-semibold text-2xl tracking-tight">Request a Quote</div>
        <div class="text-sm text-spg-text-light">We’ll get back to you within 2 hours</div>
      </div>
      <button id="modal-close" class="text-spg-text-light hover:text-spg-text p-1" aria-label="Close modal">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <form id="quote-form" class="px-7 py-7 space-y-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label for="quote-name" class="text-sm font-medium block mb-1.5">Full Name *</label>
          <input id="quote-name" required type="text" name="name" class="form-input w-full rounded-2xl px-4 py-3 text-sm" placeholder="Jane Cooper">
        </div>
        <div>
          <label for="quote-company" class="text-sm font-medium block mb-1.5">Company / Property</label>
          <input id="quote-company" type="text" name="company" class="form-input w-full rounded-2xl px-4 py-3 text-sm" placeholder="Acme Distribution LLC">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label for="quote-phone" class="text-sm font-medium block mb-1.5">Phone Number *</label>
          <input id="quote-phone" required type="tel" name="phone" class="form-input w-full rounded-2xl px-4 py-3 text-sm" placeholder="(555) 123-4567">
        </div>
        <div>
          <label for="quote-email" class="text-sm font-medium block mb-1.5">Email Address *</label>
          <input id="quote-email" required type="email" name="email" class="form-input w-full rounded-2xl px-4 py-3 text-sm" placeholder="you@company.com">
        </div>
      </div>

      <div>
        <label for="quote-service" class="text-sm font-medium block mb-1.5">Service Needed *</label>
        <select id="quote-service" required name="service" class="form-input w-full rounded-2xl px-4 py-3 text-sm bg-white">
          <option value="">Please select a service</option>
          <option value="Handyman Services">Handyman Services</option>
          <option value="Warehouse Management">Commercial Warehouse Management</option>
          <option value="Property Maintenance">Commercial Property Maintenance</option>
          <option value="Commercial Plumbing">Commercial Plumbing</option>
          <option value="Multiple / Other">Multiple Services or Other</option>
        </select>
      </div>

      <div>
        <label for="quote-details" class="text-sm font-medium block mb-1.5">Tell us about the project *</label>
        <textarea id="quote-details" required name="details" rows="3" class="form-input w-full rounded-3xl px-4 py-3 text-sm resize-y" placeholder="Please describe the scope, timeline, and any special requirements..."></textarea>
      </div>

      <div class="pt-3">
        <button type="submit" class="btn-primary w-full text-white py-[17px] font-semibold rounded-2xl text-base tracking-wider">
          SUBMIT REQUEST
        </button>
        <p class="text-center text-xs text-spg-text-light mt-4">We respect your time. Your information is never shared.</p>
      </div>
    </form>

    <div id="quote-success" class="hidden px-8 py-14 text-center">
      <div class="mx-auto w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 10l7-7m0 0l7 7" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 3v18" />
        </svg>
      </div>
      <h3 class="text-2xl font-semibold text-spg-green">Thank you!</h3>
      <p class="mt-3 text-spg-text-light max-w-[260px] mx-auto">Your quote request has been received. A member of our team will contact you shortly.</p>
    </div>
  </div>
</div>
