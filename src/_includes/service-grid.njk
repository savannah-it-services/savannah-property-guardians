<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
{% for item in gridItems %}
  <a href="{{ item.href }}" class="service-card group bg-white rounded-3xl p-7 flex flex-col">
    <div class="service-icon w-12 h-12 rounded-2xl bg-[#F1EDE3] flex items-center justify-center text-spg-green mb-5">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
        {{ iconMap[item.key] | safe }}
      </svg>
    </div>
    <h3 class="text-xl font-semibold tracking-tight mb-2 text-spg-green group-hover:text-spg-gold transition-colors">{{ item.title }}</h3>
    <p class="text-sm text-spg-text-light leading-relaxed flex-1">{{ item.desc }}</p>
    <div class="mt-5 text-xs font-semibold tracking-widest text-spg-gold flex items-center gap-1 group-hover:gap-1.5 transition-all">LEARN MORE <span>→</span></div>
  </a>
{% endfor %}
</div>
